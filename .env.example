# Local brain (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Dual local routing (Local mode only)
VOXORYL_MAIN_MODEL=qwen3.5:4b
VOXORYL_FAST_MODEL=qwen2.5:0.5b

# Local vs Cloud inference (widget Settings can override → data/inference_prefs.json)
# local = privacy (Ollama fast+main). cloud = free streaming LLM API; tools still local.
VOXORYL_INFERENCE_MODE=local
# Provider: groq | gemini | openrouter | nvidia
VOXORYL_CLOUD_PROVIDER=groq
# Shared cloud key (optional). Else use provider-specific keys below.
VOXORYL_CLOUD_API_KEY=
VOXORYL_CLOUD_MODEL=

# —— Free cloud API keys (sign up yourself — never paste scraped/stolen keys) ——
#
# Groq (recommended primary — fastest free streaming)
# 1) https://console.groq.com/keys → Create API Key (no card)
# 2) Paste into GROQ_API_KEY below, keep VOXORYL_CLOUD_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
#
# Google AI Studio / Gemini
# 1) https://aistudio.google.com/apikey → Create API key
# 2) Set VOXORYL_CLOUD_PROVIDER=gemini and paste into GEMINI_API_KEY
GEMINI_API_KEY=
#
# NVIDIA NIM (OpenAI-compatible hosted API)
# 1) https://build.nvidia.com → Get API Key (nvapi-…)
# 2) Set VOXORYL_CLOUD_PROVIDER=nvidia and paste into NVIDIA_API_KEY
NVIDIA_API_KEY=
#
# OpenRouter free models
# 1) https://openrouter.ai/keys
# 2) Set VOXORYL_CLOUD_PROVIDER=openrouter and paste into OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Paths (portable — relative to repo root)
VOXORYL_DATA_DIR=./data
VOXORYL_WORKSPACE=./workspace_sandbox
VOXORYL_PORT=3847
VOXORYL_HOST=127.0.0.1

# Owner / Chrome profile (optional — used for “open my profile” matching)
# Leave blank for generic “Default” / “my profile” matching only.
VOXORYL_OWNER_NAME=
VOXORYL_OWNER_EMAIL=
# Comma-separated alternate match phrases for your Chrome profile card
VOXORYL_CHROME_PROFILE_MATCH=
# photo | orange | any — vision hint when the profile picker is shown
VOXORYL_CHROME_PROFILE_PREFER=photo

# Accurate mic ASR — Parakeet (same family Hex uses). auto|parakeet|whisper
ASR_BACKEND=auto
ASR_MODEL=nemo-parakeet-tdt-0.6b-v3
WHISPER_MODEL=small

# Voxoryl speaking voice (edge-tts)
# Good options: en-US-AndrewMultilingualNeural (default), en-IN-PrabhatNeural
# Hindi: hi-IN-MadhurNeural · Spanish: es-ES-AlvaroNeural · French: fr-FR-HenriNeural
TTS_VOICE=en-US-AndrewMultilingualNeural

# Notes — set to your Obsidian vault folder to auto-save notes there
OBSIDIAN_VAULT=

# GitHub — personal access token and/or username
GITHUB_TOKEN=
GITHUB_USER=

# Email — IMAP read-only triage
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX

# Local AI video (ComfyUI)
COMFYUI_URL=http://127.0.0.1:8188

# Screen see + mouse/keyboard control (YOUR PC only)
# Set true to allow Voxoryl to screenshot, click, and type.
COMPUTER_USE_ENABLED=false
OLLAMA_VISION_MODEL=qwen2.5vl:3b
COMPUTER_USE_MAX_STEPS=12
COMPUTER_USE_PAUSE=0.12
# Always-on light screen context for Talk mode (requires COMPUTER_USE_ENABLED=true)
SCREEN_WATCH_ENABLED=true
SCREEN_WATCH_INTERVAL_SEC=45

# Embeddings (pull: ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional self-hosted search (docker run searxng/searxng)
SEARXNG_URL=

# Optional SMTP — only used AFTER you approve lead outreach drafts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Vercel — only used AFTER you approve a site deploy
# https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Optional Hyper-V golden template VM name (for sandbox clones; Windows only)
VOXORYL_HV_TEMPLATE=

# Camera / Android notes:
# - Camera: pip install opencv-python (or opencv-python-headless)
# - Android: install SDK, set ANDROID_HOME, create an AVD
